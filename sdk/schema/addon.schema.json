{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://website-core.local/schemas/addon.schema.json",
    "title": "Website Core package manifest (schema v1)",
    "type": "object",
    "required": ["schema", "id", "type", "name", "version", "license"],
    "additionalProperties": true,
    "properties": {
        "schema": { "const": 1 },
        "id": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9_-]*/[a-z0-9][a-z0-9_-]*$",
            "description": "Stable publisher/package id"
        },
        "type": { "enum": ["industry", "addon", "theme"] },
        "name": { "type": "string", "minLength": 1 },
        "version": {
            "type": "string",
            "pattern": "^\\d+\\.\\d+\\.\\d+(-[0-9A-Za-z.-]+)?(\\+[0-9A-Za-z.-]+)?$"
        },
        "license": { "type": "string", "minLength": 1 },
        "license_key": {
            "type": "string",
            "minLength": 8,
            "description": "License key binding this module to a specific site"
        },
        "requires": {
            "type": "object",
            "properties": {
                "core": { "type": "string" },
                "api": { "type": "integer" },
                "php": { "type": "string" }
            },
            "additionalProperties": false
        },
        "dependencies": {
            "type": "object",
            "propertyNames": { "pattern": "^[a-z0-9][a-z0-9_-]*/[a-z0-9][a-z0-9_-]*$" },
            "additionalProperties": { "type": "string" }
        },
        "conflicts": {
            "type": "object",
            "propertyNames": { "pattern": "^[a-z0-9][a-z0-9_-]*/[a-z0-9][a-z0-9_-]*$" },
            "additionalProperties": { "type": "string" }
        },
        "entry": { "type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+\\.php$" },
        "provider": { "type": "string", "pattern": "^(?:[A-Za-z_][A-Za-z0-9_]*\\\\)+[A-Za-z_][A-Za-z0-9_]*$" },
        "psr4": { "type": "object", "propertyNames": { "pattern": "^(?:[A-Za-z_][A-Za-z0-9_]*\\\\)+$" }, "additionalProperties": { "$ref": "#/$defs/relativePath" } },
        "capabilities": { "type": "array", "items": { "type": "string", "pattern": "^[a-z0-9_.:-]+$" } },
        "migrations": { "oneOf": [{ "$ref": "#/$defs/relativePath" }, { "type": "array", "minItems": 1, "maxItems": 20, "items": { "$ref": "#/$defs/relativePath" } }] },
        "assets": {
            "type": "object",
            "properties": {
                "css": { "type": "array", "items": { "$ref": "#/$defs/relativePath" } },
                "js": { "type": "array", "items": { "$ref": "#/$defs/relativePath" } },
                "images": { "type": "array", "items": { "$ref": "#/$defs/relativePath" } }
            },
            "additionalProperties": false
        },
        "integrity": {
            "type": "object",
            "properties": {
                "files": { "type": "object", "propertyNames": { "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$" }, "additionalProperties": { "type": "string", "pattern": "^[a-f0-9]{64}$" } }
            },
            "required": ["files"]
        },
        "tokens": { "type": "object" },
        "templates": { "type": "array", "items": { "type": "string" } }
    },
    "$defs": {
        "relativePath": { "type": "string", "minLength": 1, "maxLength": 500, "pattern": "^(?!/)(?![A-Za-z]:/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$" }
    }
}
