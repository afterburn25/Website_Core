# Only the thin admin directory entry is public. Controllers and views remain
# protected source files; all application requests still use the root front
# controller.
Options -Indexes
DirectoryIndex index.php

<IfModule mod_authz_core.c>
    <FilesMatch "^(?!index\.php$).+">
        Require all denied
    </FilesMatch>
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
    <Files "index.php">
        Order allow,deny
        Allow from all
    </Files>
</IfModule>
