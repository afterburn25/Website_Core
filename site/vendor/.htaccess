# Deny direct HTTP access to Composer runtime source and metadata.
# Required even when mod_rewrite is disabled or the site is installed
# in a subfolder. PHP accesses these files locally via the filesystem.
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>
<IfModule !mod_authz_core.c>
    Order deny,allow
    Deny from all
</IfModule>
